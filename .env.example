# Copy to .env for local development. Replace all example values.
MONGO_ROOT_USERNAME=blog_dev
MONGO_ROOT_PASSWORD=change-me-local
MONGO_DATABASE=blog
MONGO_PORT=27017
FRONTEND_PORT=8443
BACKEND_PORT=8080
# Local-only admin bootstrap; use unique Coolify secrets in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-admin

# Used by the production Compose file. Keep credentials in an untracked .env.
IMAGE_NAMESPACE=ghcr.io/your-org/your-repo
IMAGE_TAG=latest
MONGODB_URI=mongodb://user:password@your-mongodb-host:27017/blog?authSource=admin&replicaSet=rs0
