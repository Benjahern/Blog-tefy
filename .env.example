# Copy to .env for local development. Replace all example values.
MONGO_ROOT_USERNAME=blog_dev
MONGO_ROOT_PASSWORD=change-me-local
MONGO_DATABASE=blog
MONGO_PORT=27017
FRONTEND_PORT=8443
BACKEND_PORT=8080
# Local-only admin bootstrap; use unique Coolify secrets in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-admin

# Used by production Compose. Keep credentials in an untracked .env.
IMAGE_REPOSITORY=bigbenj4/appblog
IMAGE_TAG=latest
SITE_URL=https://nia.hmx.cl
API_UPSTREAM=http://backend:8080
CLARITY_ID=z94p2ywzos
PROD_FRONTEND_PORT=8092
PROD_BACKEND_PORT=8091
APP_ENV=production
COOKIE_SECURE=true
MONGODB_URI=mongodb://blog_dev:change-me-local@mongo:27017/blog?authSource=admin
